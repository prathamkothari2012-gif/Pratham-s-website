# Password for the owner dashboard at /admin.
# Required in production — the app refuses to start without it.
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Where the JSON datastore is written when running on a normal server.
# Point this at a persistent volume in Docker. Ignored on Netlify, which uses
# Netlify Blobs instead.
# DATA_DIR=/var/lib/spoolhouse

# Public address, used for canonical links and the sitemap. On Netlify this is
# filled in automatically, so leave it unset until you attach a real domain.
# SITE_URL=https://3dspoolhouse.in

# --- Sending one-time codes ---
# Checkout verifies the customer's email and mobile by 6-digit code. With
# neither of these set the code is printed to the server log instead of being
# sent, which keeps the flow working locally but is not usable in production.

# Email codes via Resend (https://resend.com). Free tier covers a small shop.
RESEND_API_KEY=
MAIL_FROM=orders@3dspoolhouse.com

# SMS codes. The adapter in src/lib/server/notify.ts is a stub — fill it in
# against your provider (MSG91, Twilio, Gupshup). Sending transactional SMS to
# Indian numbers also needs DLT registration and an approved template.
SMS_API_KEY=
SMS_SENDER_ID=
